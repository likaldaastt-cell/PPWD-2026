#!/bin/bash
set -Eeuo pipefail

GIT_PATH="/www/wwwroot/students/student32"
LOG_FILE="/tmp/aapanel-student32-testing-deploy.log"

exec >> "$LOG_FILE" 2>&1

echo ""
echo "======================================"
echo "Deploy dimulai: $(date)"
echo "======================================"

cd "$GIT_PATH"

echo "[1] Mengambil kode terbaru dari GitHub..."
git -c safe.directory="$GIT_PATH" fetch origin main

echo "[2] Memperbarui file dari origin/main..."
git -c safe.directory="$GIT_PATH" reset --hard origin/main

echo "[3] Commit yang terpasang:"
git -c safe.directory="$GIT_PATH" log -1 --oneline

echo "[4] Memeriksa perubahan index.html..."
grep -n "aaPanel" "$GIT_PATH/index.html"

echo "[5] Menyesuaikan kepemilikan file..."
chown -R www:www "$GIT_PATH"

echo "DEPLOY BERHASIL: $(date)"
